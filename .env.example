# Copy to .env.local and fill in what you need.
# Leave it all blank and the app just runs on mock data.

# Auth (Auth.js). Skip this locally, only needed for the prod-style build.
AUTH_SECRET=
AUTH_URL=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Upstash Redis, used for rate limiting + the ingest cooldown. Falls back to
# in-memory if empty, which is fine locally but won't share state across
# serverless instances in prod.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Alpaca: prices/quotes/candles, our main market data source.
# alpaca.markets, same keys work for both paper and market data.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_FEED=             # iex (default, free) or sip
ALPACA_HISTORICAL_FEED=  # sip (default, free w/ 15min delay) or iex

# Finnhub: company profile, peers, symbol search.
FINNHUB_API_KEY=

# Polygon: news + sentiment, and backup for prices/search if Alpaca/Finnhub
# aren't set.
POLYGON_API_KEY=

# Astra DB: stores the AI-analyzed news articles.
ASTRA_DB_APPLICATION_TOKEN=
ASTRA_DB_API_ENDPOINT=
ASTRA_DB_NEWS_COLLECTION=      # defaults to prototype_db_v2
ASTRA_DB_ANALYSIS_COLLECTION=  # defaults to stock_analysis

# Groq: the primary LLM lane behind analysis + chat.
GROQ_API_KEY=
GROQ_ANALYSIS_MODEL=  # defaults to an 8b model, used for batch analysis
GROQ_CHAT_MODEL=       # defaults to a 70b model, used for the chatbot
GROQ_FALLBACK_MODEL=   # defaults to llama-3.3-70b-versatile for chat failover
GROQ_OSS_MODEL=        # defaults to openai/gpt-oss-20b, extra failover lane (separate Groq quota)

# Cerebras + Gemini: independent free-tier LLM lanes for chat synthesis.
# With these set, chat keeps its full brain even when Groq is
# rate-limited. Cerebras: cloud.cerebras.ai. Gemini: aistudio.google.com.
CEREBRAS_API_KEY=
CEREBRAS_CHAT_MODEL=  # defaults to gpt-oss-120b
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=    # defaults to gemini-2.5-flash-lite (1,000 req/day free; plain flash is only 20/day)

# Tavily: fresh server-side web retrieval for regular StockSage chat.
TAVILY_API_KEY=

# Langflow: batch-analysis orchestration, plus the first-choice synthesis lane
# for Deep Research (falls back to the direct multi-provider path if the host
# is cold or down). Regular chat never depends on this host.
LANGFLOW_BASE_URL=
LANGFLOW_API_KEY=
LANGFLOW_FLOW_ID=          # chat flow
LANGFLOW_ANALYZE_FLOW_ID=  # analysis flow, leave blank to skip Langflow here
LANGFLOW_INGEST_FLOW_ID=   # ingestion flow (Tavily, then Gemini, then Astra)

# Usually leave these two blank, we auto-resolve them from the live flow.
# Only set if auto-resolution can't find the flow.
LANGFLOW_CHAT_PROMPT_ID=
LANGFLOW_CHAT_LLM_ID=
STOCKSAGE_DEEP_SNAPSHOT_SECRET=  # optional; falls back to AUTH_SECRET or NEXTAUTH_SECRET

# Cron secret for /api/cron/news. Vercel's cron and our GitHub Action both
# send this as `Authorization: Bearer <secret>`, route 401s without it.
CRON_URL=
CRON_SECRET=
# CRON_BATCH_SIZE=8
# CRON_MAX_ANALYSES=3

QSTASH_URL=
QSTASH_TOKEN=
