# Copy to .env.local and fill in what you need.
# Leave it all blank and the app just runs on mock data.

# Auth (Auth.js). Skip this locally, only needed for the prod-style build.
AUTH_SECRET=
AUTH_URL=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Upstash Redis, used for rate limiting + the ingest cooldown. Falls back to
# in-memory if empty, which is fine locally but won't share state across
# serverless instances in prod.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Alpaca: prices/quotes/candles, our main market data source.
# alpaca.markets, same keys work for both paper and market data.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_FEED=             # iex (default, free) or sip
ALPACA_HISTORICAL_FEED=  # sip (default, free w/ 15min delay) or iex

# Finnhub: company profile, peers, symbol search.
FINNHUB_API_KEY=

# Polygon: news + sentiment, and backup for prices/search if Alpaca/Finnhub
# aren't set.
POLYGON_API_KEY=

# Astra DB: stores the AI-analyzed news articles.
ASTRA_DB_APPLICATION_TOKEN=
ASTRA_DB_API_ENDPOINT=
ASTRA_DB_NEWS_COLLECTION=      # defaults to prototype_db_v2
ASTRA_DB_ANALYSIS_COLLECTION=  # defaults to stock_analysis

# Groq: the primary LLM lane behind analysis + chat.
GROQ_API_KEY=
GROQ_ANALYSIS_MODEL=  # defaults to openai/gpt-oss-20b, used for batch analysis
GROQ_CHAT_MODEL=       # defaults to qwen/qwen3.6-27b, used for the chatbot
GROQ_FALLBACK_MODEL=   # defaults to openai/gpt-oss-120b for chat failover
GROQ_OSS_MODEL=        # defaults to openai/gpt-oss-20b, extra failover lane (separate Groq quota)
GROQ_SAFETY_MODEL=     # defaults to openai/gpt-oss-safeguard-20b, the chat input-safety rail

# Set to `off` to disable the safeguard input rail without giving up Groq
# synthesis. Chat then runs on the regex prefilter alone.
STOCKSAGE_SAFETY_CLASSIFIER=

# Cerebras + Gemini: independent free-tier LLM lanes for chat synthesis.
# With these set, chat keeps its full brain even when Groq is
# rate-limited. Cerebras: cloud.cerebras.ai. Gemini: aistudio.google.com.
CEREBRAS_API_KEY=
CEREBRAS_CHAT_MODEL=  # defaults to gpt-oss-120b
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=    # defaults to gemini-2.5-flash-lite (1,000 req/day free; plain flash is only 20/day)

# Tavily: fresh server-side web retrieval for regular StockSage chat.
TAVILY_API_KEY=

# Langflow is manual/evaluation-only for the retained analysis flow.
# Production StockSage and scheduled analysis call Groq directly.
LANGFLOW_BASE_URL=
LANGFLOW_API_KEY=
LANGFLOW_ANALYZE_FLOW_ID=  # only used by explicit manual evaluation
STOCKSAGE_DEEP_SNAPSHOT_SECRET=  # optional; falls back to AUTH_SECRET or NEXTAUTH_SECRET

# Cron secret for /api/cron/showcase and /api/cron/maintenance. QStash and
# Vercel send this as `Authorization: Bearer <secret>`.
CRON_URL=
CRON_SECRET=

QSTASH_URL=
QSTASH_TOKEN=
# Deep Research and market-intelligence workers require a token, public app URL,
# signing key, and Upstash Redis. Market intelligence fails closed rather than
# running provider or LLM work inside a user request.
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
APP_URL=  # public origin QStash calls back on; falls back to NEXTAUTH_URL
# On-demand ticker jobs only; showcase jobs have their own fixed 240/day lane.
MARKET_INTELLIGENCE_ON_DEMAND_DAILY_BUDGET=300
MARKET_INTELLIGENCE_USER_DAILY_LIMIT=20

# Evaluation only. `npm run bench:asx` may call these to measure what a
# licensed ASX feed would deliver; the request path never reads them.
ASX_EVAL_PROVIDER=  # eodhd | marketstack
EODHD_API_KEY=
MARKETSTACK_API_KEY=
