# Copy this file to .env.local (local dev) or set these in the Vercel dashboard
# (Production + Preview). The app runs fully in open demo mode with mock data
# when everything here is empty — and CANNOT incur any third-party cost until
# you add the relevant provider keys below.

# ─────────────────────────────────────────────────────────────────────────────
# AUTHENTICATION (Auth.js / NextAuth v5)  —  required for the live, gated site
# ─────────────────────────────────────────────────────────────────────────────
# Generate a secret with:  openssl rand -base64 32
AUTH_SECRET=
# Your site's canonical URL. Locally: http://localhost:3000
# On Vercel this is auto-detected, but set it explicitly for custom domains.
AUTH_URL=

# Google OAuth — https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: https://<your-domain>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Apple OAuth — https://developer.apple.com (requires the $99/yr Apple Developer
# Program). AUTH_APPLE_SECRET is a JWT you generate from your .p8 key; it expires
# (max 6 months) and must be rotated. See README "Apple Sign In" for the script.
# Redirect URI: https://<your-domain>/api/auth/callback/apple
AUTH_APPLE_ID=
AUTH_APPLE_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# RATE LIMITING (Upstash Redis)  —  strongly recommended before going public
# ─────────────────────────────────────────────────────────────────────────────
# Free serverless Redis: https://upstash.com (or add via the Vercel Marketplace).
# Without these, rate limiting falls back to per-instance in-memory (weaker on
# serverless). With them, limits are enforced globally across all instances.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─────────────────────────────────────────────────────────────────────────────
# MARKET DATA — PRICES / QUOTES / VOLUME (Alpaca Market Data, PREFERRED)
# ─────────────────────────────────────────────────────────────────────────────
# Free key: https://alpaca.markets (Trading API → generate keys; the same keys
# work for Market Data). Free tier ≈ 200 req/min with deep history — the
# PREFERRED source for all price/volume data (daily candles, 1-min intraday,
# 15-min bars, and multi-symbol snapshots for movers/related).
# SERVER-ONLY — never prefix with NEXT_PUBLIC_.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
# Snapshot / latest-quote feed. Free accounts must use "iex" (default); SIP
# snapshots need a paid plan. Real-time price is accurate on IEX.
ALPACA_FEED=
# Historical bars feed. Defaults to "sip" (100% of US volume) — FREE for windows
# ending ≥15 min ago, which is what makes trade counts/volume truthful instead of
# the ~2.5% IEX slice. Set to "iex" only to force the single-exchange feed.
ALPACA_HISTORICAL_FEED=

# ─────────────────────────────────────────────────────────────────────────────
# MARKET DATA — SEARCH / PROFILE / PEERS (Finnhub, PREFERRED)
# ─────────────────────────────────────────────────────────────────────────────
# Free key: https://finnhub.io/register  (free tier ≈ 60 req/min). Powers symbol
# search enrichment, company profile (name / market cap / industry), and peers
# (related tickers). SERVER-ONLY — never prefix with NEXT_PUBLIC_.
FINNHUB_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# MARKET DATA — NEWS + SENTIMENT, and price/search/peers FALLBACK (Polygon.io)
# ─────────────────────────────────────────────────────────────────────────────
# Free key: https://polygon.io/dashboard/signup  (free tier ≈ 5 requests/min).
# Used EXCLUSIVELY for the news+sentiment call (whose articles carry per-ticker
# insights), plus as the automatic FALLBACK for prices/search/peers when the
# Alpaca/Finnhub keys above are absent — so the app behaves exactly as it did
# before and "lights up" the dedicated providers once their keys are added.
# SERVER-ONLY. Do NOT prefix with NEXT_PUBLIC_ — that would ship the key to the
# browser where anyone could steal it.
POLYGON_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# NEWS + SENTIMENT + COMPANIES (DataStax / IBM Astra DB)
# ─────────────────────────────────────────────────────────────────────────────
# Create a free vector database: https://astra.datastax.com
ASTRA_DB_APPLICATION_TOKEN=
ASTRA_DB_API_ENDPOINT=
# Optional: override the news collection name (defaults to prototype_db_v2)
ASTRA_DB_NEWS_COLLECTION=

# ─────────────────────────────────────────────────────────────────────────────
# STOCKSAGE AI — GROQ (the LLM behind BOTH lanes: chat + deep analysis)
# ─────────────────────────────────────────────────────────────────────────────
# Free key: https://console.groq.com. One account, two models: an 8B model for
# batch analysis (roomy daily bucket) and a 70B model for interactive chat. Groq
# is BOTH the analysis engine AND the fallback whenever a Langflow flow is down.
# In hosted Langflow, ALSO add this same key as a global variable named
# GROQ_API_KEY (Settings → Global Variables) so the flows' Groq nodes can use it.
# SERVER-ONLY — never prefix with NEXT_PUBLIC_.
GROQ_API_KEY=
# Optional model overrides (sensible defaults are baked in).
GROQ_ANALYSIS_MODEL=
GROQ_CHAT_MODEL=

# ─────────────────────────────────────────────────────────────────────────────
# STOCKSAGE AI — LANGFLOW (the visible orchestration; Groq-backed flows)
# ─────────────────────────────────────────────────────────────────────────────
# Re-host the flows (see the langflow/ directory + its README) locally or on a
# hosted Langflow instance, then fill these in. Example base URL: http://localhost:7860
# Every Langflow call has a direct-Groq fallback, so the app still answers if the
# flow host is down (as long as GROQ_API_KEY above is set).
LANGFLOW_BASE_URL=
LANGFLOW_API_KEY=
# Chat flow id (RAG chat, llama-3.3-70b-versatile).
LANGFLOW_FLOW_ID=
# Deep-analysis flow id (stateless articles→labels, llama-3.1-8b-instant). Leave
# empty to keep analysis on direct Groq only (no Langflow attempt).
LANGFLOW_ANALYZE_FLOW_ID=
# The app sends grounding (live quotes / history / focus tickers) and StockSage's
# system message to two nodes in the chat flow via Langflow tweaks. Langflow
# regenerates node-ID suffixes on every import, so the app RESOLVES these IDs
# automatically from the live flow (matching by prefix) — you normally leave both
# blank. Only set them to pin specific IDs if auto-resolution can't reach the flow.
LANGFLOW_CHAT_PROMPT_ID=
LANGFLOW_CHAT_LLM_ID=

# ─────────────────────────────────────────────────────────────────────────────
# BACKGROUND LANE (GitHub Actions + Vercel cron → /api/cron/news)
# ─────────────────────────────────────────────────────────────────────────────
# Self-generated secret (e.g. `openssl rand -base64 32`). Set it in the Vercel
# dashboard; Vercel attaches `Authorization: Bearer ${CRON_SECRET}` to its daily
# backstop run, and the news-cron GitHub Action sends the same header every ~5
# minutes (repository secrets CRON_URL + CRON_SECRET — see
# .github/workflows/news-cron.yml). Without it the endpoint rejects all calls.
CRON_SECRET=
# Optional cron knobs (defaults shown): tickers loaded per run, and the cap on
# Groq-calling analyses per run (Groq free tier is ~6k tokens/min for the 8B
# model, so ~1 analysis/minute is the sustainable pace).
# CRON_BATCH_SIZE=8
# CRON_MAX_ANALYSES=3
