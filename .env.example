# Copy to .env.local and fill in what you need.
# Leave it all blank and the app just runs on mock data.

# Auth (Auth.js). Skip this locally, only needed for the prod-style build.
AUTH_SECRET=
AUTH_URL=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Upstash Redis, used for rate limiting, queue state, leases, and cooldowns. Falls back to
# in-memory if empty, which is fine locally but won't share state across
# serverless instances in prod.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Alpaca: prices/quotes/candles, our main market data source.
# alpaca.markets, same keys work for both paper and market data.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_FEED=             # iex (default, free) or sip
ALPACA_HISTORICAL_FEED=  # sip (default, free w/ 15min delay) or iex

# Finnhub: company profile, peers, symbol search.
FINNHUB_API_KEY=

# Polygon: news + sentiment, and backup for prices/search if Alpaca/Finnhub
# aren't set.
POLYGON_API_KEY=

# Astra DB: stores the AI-analyzed news articles.
ASTRA_DB_APPLICATION_TOKEN=
ASTRA_DB_API_ENDPOINT=
ASTRA_DB_NEWS_COLLECTION=      # defaults to prototype_db_v2
ASTRA_DB_ANALYSIS_COLLECTION=  # defaults to stock_analysis

# StockSage model selection. These work the same locally and in production.
# Set the provider to `groq` for Qwen or `cerebras` for GPT-OSS.
# When both API keys are configured, transient/429 failures automatically use
# the other provider and its default model.
STOCKSAGE_SIMPLE_PROVIDER=cerebras  # cerebras (default) | groq
STOCKSAGE_SIMPLE_MODEL=             # optional provider-specific model override

# Groq: Qwen for StockSage when selected, plus market-intelligence analysis.
GROQ_API_KEY=
GROQ_ANALYSIS_MODEL=  # defaults to openai/gpt-oss-20b, used for batch analysis
GROQ_CHAT_MODEL=       # defaults to qwen/qwen3.6-27b, used for the chatbot

# Cerebras: GPT-OSS for the simple runtime when selected.
CEREBRAS_API_KEY=
CEREBRAS_MODEL=        # defaults to gpt-oss-120b

# Tavily: fresh server-side web retrieval for StockSage.
TAVILY_API_KEY=

# Cron secret for /api/cron/showcase and /api/cron/maintenance. QStash and
# Vercel send this as `Authorization: Bearer <secret>`.
CRON_SECRET=

QSTASH_URL=
QSTASH_TOKEN=
# Market-intelligence workers require a token, public app URL, signing key, and
# Upstash Redis. They fail closed rather than running provider or LLM work
# inside a user request.
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
APP_URL=  # public origin QStash calls back on; falls back to NEXTAUTH_URL
# On-demand ticker jobs only; showcase schedules 480 jobs/day before retries.
MARKET_INTELLIGENCE_ON_DEMAND_DAILY_BUDGET=300
MARKET_INTELLIGENCE_USER_DAILY_LIMIT=20
MARKET_INTELLIGENCE_USER_BURST_LIMIT=10
